{
  "name": "wobble-svg",
  "version": "0.1.0",
  "description": "Variable-width hand-drawn SVG path generator for web and React Native. Deterministic, dependency-free, and tuned to procedural design systems.",
  "keywords": [
    "svg",
    "hand-drawn",
    "procedural",
    "paths",
    "react-native",
    "design-systems",
    "shapegen",
    "wobble"
  ],
  "license": "MIT",
  "author": "Daphne Cheng <daphne.cheng.pink@gmail.com>",
  "homepage": "https://blu-octopus.github.io/wobble-strokes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blu-octopus/wobble-strokes.git"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "site:prepare": "mkdir -p site/vendor && cp dist/index.mjs site/vendor/wobble-svg.mjs",
    "site:favicons": "npm run build && node scripts/generate-favicons.mjs",
    "site:dev": "npm run build && npm run site:prepare && npx --yes serve site -l 5183",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitepress": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
